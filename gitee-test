#!/usr/bin/env bash
# gitee-test — Environment diagnostics & smoke tests for gitee-cli
# Generates a Markdown report so AI agents can quickly see what's wrong.
# Usage: ./gitee-test [report.md]
set -uo pipefail

REPORT_FILE="${1:-gitee-test-report.md}"
GITEE_BIN="${GITEE_BIN:-./gitee}"
API_BASE="${GITEE_API_BASE:-https://gitee.com/api/v5}"

# ─── Helpers ─────────────────────────────────────────────────
_pass() { echo "✅ $1"; }
_fail() { echo "❌ $1"; }
_skip() { echo "⏭️  $1"; }
_warn() { echo "⚠️  $1"; }

_cmd_exists() { command -v "$1" >/dev/null 2>&1; }
_cmd_version() { "$1" --version 2>/dev/null | head -n 1 || echo "unknown"; }

# No ANSI colors — keeps output clean and AI-parseable across all terminals
# Status is conveyed via emoji prefixes (✅ ❌ ⏭️) instead

# Counters
TOTAL=0 PASS=0 FAIL=0 SKIP=0

# Report buffer
REPORT="# gitee-cli Test Report

> Generated: $(date -Iseconds)
> Host: $(uname -s -r)
> Working Dir: $(pwd)

"

run_test() {
    local name="$1" cmd="$2"
    local expected_ok="${3:-1}"  # 1 = should pass, 0 = expected to fail
    local out="" rc=0 start end elapsed
    TOTAL=$((TOTAL + 1))

    printf "  %-50s " "$name ..."
    start=$(date +%s.%N 2>/dev/null || date +%s)
    out=$(eval "$cmd" 2>&1) || rc=$?
    end=$(date +%s.%N 2>/dev/null || date +%s)
    elapsed=$(awk "BEGIN {printf \"%.0f\", ($end - $start) * 1000}" 2>/dev/null || echo "?")

    if [[ "$expected_ok" == "1" && "$rc" -eq 0 ]]; then
        PASS=$((PASS + 1))
        printf "PASS (%sms)\n" "$elapsed"
        REPORT+="## ✅ $name\n\n- **Status**: PASS\n- **Duration**: ${elapsed}ms\n- **Output**:\n\n\`\`\`\n$out\n\`\`\`\n\n"
    elif [[ "$expected_ok" == "0" && "$rc" -ne 0 ]]; then
        PASS=$((PASS + 1))
        printf "PASS (expected failure) (%sms)\n" "$elapsed"
        REPORT+="## ✅ $name (expected failure)\n\n- **Status**: PASS\n- **Duration**: ${elapsed}ms\n- **Output**:\n\n\`\`\`\n$out\n\`\`\`\n\n"
    elif [[ "$expected_ok" == "0" && "$rc" -eq 0 ]]; then
        FAIL=$((FAIL + 1))
        printf "FAIL (expected failure but succeeded) (%sms)\n" "$elapsed"
        REPORT+="## ❌ $name\n\n- **Status**: FAIL (expected failure but succeeded)\n- **Duration**: ${elapsed}ms\n- **Output**:\n\n\`\`\`\n$out\n\`\`\`\n\n"
    else
        FAIL=$((FAIL + 1))
        printf "FAIL (%sms)\n" "$elapsed"
        REPORT+="## ❌ $name\n\n- **Status**: FAIL (exit code $rc)\n- **Duration**: ${elapsed}ms\n- **Output**:\n\n\`\`\`\n$out\n\`\`\`\n\n"
    fi
}

run_check() {
    local name="$1" out="" rc=0
    TOTAL=$((TOTAL + 1))
    printf "  %-50s " "$name ..."
    out=$(eval "$2" 2>&1) || rc=$?
    if [[ "$rc" -eq 0 ]]; then
        PASS=$((PASS + 1))
        printf "OK\n"
        REPORT+="| $name | ✅ OK | \`$out\` |\n"
    else
        FAIL=$((FAIL + 1))
        printf "MISSING\n"
        REPORT+="| $name | ❌ MISSING | — |\n"
    fi
}

# ─── Start ───────────────────────────────────────────────────
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "  gitee-cli Diagnostic & Smoke Test"
echo "═══════════════════════════════════════════════════════════════"
echo ""

# 1. Environment
echo "[1/4] Environment Dependencies"
REPORT+="## Environment Dependencies\n\n| Item | Status | Version / Path |\n|------|--------|----------------|\n"
run_check "bash"        "bash --version | head -n1"
run_check "curl"        "command -v curl"
run_check "python3"     "command -v python3"
run_check "git"         "command -v git"

# Python 3.6+ check (f-strings)
PY_OK=0
if _cmd_exists python3; then
    PY_VER=$(python3 -c "import sys; print(sys.version_info.major, sys.version_info.minor)" 2>/dev/null)
    if [[ "$PY_VER" =~ ^3\ (6|[7-9]|1[0-9])$ ]]; then
        PY_OK=1
        TOTAL=$((TOTAL + 1))
        PASS=$((PASS + 1))
        printf "  %-50s OK (Python %s)\n" "python3 >= 3.6 ..." "${PY_VER// /}"
        REPORT+="| python3 >= 3.6 | ✅ OK | $PY_VER |\n"
    else
        TOTAL=$((TOTAL + 1))
        FAIL=$((FAIL + 1))
        printf "  %-50s FAIL (Python %s)\n" "python3 >= 3.6 ..." "${PY_VER// /}"
        REPORT+="| python3 >= 3.6 | ❌ FAIL | $PY_VER |\n"
    fi
else
    TOTAL=$((TOTAL + 1))
    SKIP=$((SKIP + 1))
    printf "  %-50s SKIP\n" "python3 >= 3.6 ..."
    REPORT+="| python3 >= 3.6 | ⏭️ SKIP | not installed |\n"
fi

echo ""

# 2. Configuration
echo "[2/4] Configuration"
REPORT+="\n## Configuration\n\n| Item | Status | Value |\n|------|--------|-------|\n"

if [[ -n "${GITEE_TOKEN:-}" ]]; then
    TOKEN_MASK="${GITEE_TOKEN:0:4}****${GITEE_TOKEN: -4}"
    TOTAL=$((TOTAL + 1))
    PASS=$((PASS + 1))
    printf "  %-50s SET (%s)\n" "GITEE_TOKEN ..." "$TOKEN_MASK"
    REPORT+="| GITEE_TOKEN | ✅ SET | $TOKEN_MASK |\n"
else
    TOTAL=$((TOTAL + 1))
    FAIL=$((FAIL + 1))
    printf "  %-50s NOT SET\n" "GITEE_TOKEN ..."
    REPORT+="| GITEE_TOKEN | ❌ NOT SET | — |\n"
fi

REMOTE_URL=$(git remote get-url gitee 2>/dev/null || git remote get-url origin 2>/dev/null || true)
if [[ -n "$REMOTE_URL" ]]; then
    TOTAL=$((TOTAL + 1))
    PASS=$((PASS + 1))
    printf "  %-50s FOUND (%s)\n" "git remote ..." "$REMOTE_URL"
    REPORT+="| git remote | ✅ FOUND | \`$REMOTE_URL\` |\n"
else
    TOTAL=$((TOTAL + 1))
    FAIL=$((FAIL + 1))
    printf "  %-50s NOT FOUND\n" "git remote ..."
    REPORT+="| git remote | ❌ NOT FOUND | — |\n"
fi

OWNER="${GITEE_OWNER:-}"
REPO="${GITEE_REPO:-}"
if [[ -z "$OWNER" || -z "$REPO" ]]; then
    if [[ -n "$REMOTE_URL" ]]; then
        REPO_PATH="${REMOTE_URL#*gitee.com[:/]}"
        REPO_PATH="${REPO_PATH%.git}"
        if [[ "$REPO_PATH" != "$REMOTE_URL" && -n "$REPO_PATH" ]]; then
            OWNER="${REPO_PATH%%/*}"
            REPO="${REPO_PATH##*/}"
        fi
    fi
fi
if [[ -n "$OWNER" && -n "$REPO" ]]; then
    TOTAL=$((TOTAL + 1))
    PASS=$((PASS + 1))
    printf "  %-50s INFERRED (%s/%s)\n" "owner/repo ..." "$OWNER" "$REPO"
    REPORT+="| owner/repo | ✅ INFERRED | $OWNER / $REPO |\n"
else
    TOTAL=$((TOTAL + 1))
    FAIL=$((FAIL + 1))
    printf "  %-50s UNKNOWN\n" "owner/repo ..."
    REPORT+="| owner/repo | ❌ UNKNOWN | — |\n"
fi

echo ""

# 3. API Smoke Tests (public — no token needed)
echo "[3/5] API Smoke Tests (Public)"
REPORT+="\n## API Smoke Tests (Public)\n\n"

if _cmd_exists curl; then
    run_test "Network: gitee.com reachable" \
        "curl -sS --connect-timeout 5 --max-time 10 -o /dev/null -w '%{http_code}' https://gitee.com" \
        1

    run_test "Public API: search repositories" \
        "$GITEE_BIN search vue 3" \
        1

    run_test "Public API: user profile" \
        "$GITEE_BIN user linus" \
        1

    run_test "Public API: trending" \
        "$GITEE_BIN trending 3" \
        1
fi

echo ""

# 4. API Smoke Tests (authenticated — requires token)
echo "[4/5] API Smoke Tests (Authenticated)"
REPORT+="\n## API Smoke Tests (Authenticated)\n\n"

if [[ -n "${GITEE_TOKEN:-}" ]]; then
    run_test "API: whoami" \
        "$GITEE_BIN whoami" \
        1

    if [[ -n "$OWNER" && -n "$REPO" ]]; then
        run_test "API: repo info" \
            "$GITEE_BIN repo" \
            1

        run_test "API: issue list" \
            "$GITEE_BIN issue list open" \
            1

        run_test "API: label list" \
            "$GITEE_BIN label list" \
            1

        run_test "API: pr list" \
            "$GITEE_BIN pr list open" \
            1

        # Expected-failure test: bad token should fail
        run_test "API: bad token returns 401" \
            "GITEE_TOKEN='bad-token-1234' $GITEE_BIN whoami" \
            0
    else
        _skip "Authenticated API smoke tests — owner/repo unknown"
        REPORT+="## ⏭️ Authenticated API Smoke Tests\n\nSkipped: owner/repo could not be inferred.\n\n"
    fi
else
    _skip "Authenticated API smoke tests — GITEE_TOKEN not set"
    REPORT+="## ⏭️ Authenticated API Smoke Tests\n\nSkipped: GITEE_TOKEN not set.\n\n"
fi

echo ""

# 5. Script sanity
echo "[5/5] Script Sanity"
REPORT+="\n## Script Sanity\n\n"

run_test "Syntax: gitee script parses" \
    "bash -n $GITEE_BIN" \
    1

run_test "Syntax: gitee-test script parses" \
    "bash -n $0" \
    1

if _cmd_exists shellcheck; then
    run_test "Lint: shellcheck gitee" \
        "shellcheck $GITEE_BIN" \
        1
else
    _skip "Lint: shellcheck not installed"
    REPORT+="## ⏭️ Lint: shellcheck\n\nSkipped: shellcheck not installed.\n\n"
fi

echo ""

# ─── Summary ─────────────────────────────────────────────────
RATE=0
if [[ "$TOTAL" -gt 0 ]]; then
    RATE=$((PASS * 100 / TOTAL))
fi

echo "═══════════════════════════════════════════════════════════════"
if [[ "$FAIL" -eq 0 ]]; then
    echo "  All tests passed   $PASS/$TOTAL ($RATE%)"
else
    echo "  Some tests failed  $PASS passed, $FAIL failed, $SKIP skipped / $TOTAL total ($RATE%)"
fi
echo "═══════════════════════════════════════════════════════════════"
echo ""
echo "Report written to: $REPORT_FILE"
echo ""

REPORT+="## Summary\n\n- **Total**: $TOTAL\n- **Passed**: $PASS\n- **Failed**: $FAIL\n- **Skipped**: $SKIP\n- **Pass Rate**: $RATE%\n"

printf '%s' "$REPORT" > "$REPORT_FILE"

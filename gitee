#!/usr/bin/env bash
# gitee — CLI for Gitee API v5 (like gh for GitHub)
# Install: source this file in ~/.zshrc, or copy to PATH
# Token:  export GITEE_TOKEN="your-token"  (Gitee → 设置 → 私人令牌)
set -euo pipefail

# ─── Config ──────────────────────────────────────────────────
GITEE_CLI_VERSION="0.2.1"
GITEE_API="${GITEE_API_BASE:-https://gitee.com/api/v5}"
GITEE_TOKEN="${GITEE_TOKEN:-}"

# ─── Auth ────────────────────────────────────────────────────
_check_token() {
    if [[ -z "$GITEE_TOKEN" ]]; then
        echo "❌ GITEE_TOKEN not set. Export it:"
        echo "   export GITEE_TOKEN=\"your-token\""
        echo "   (Get one at: Gitee → 设置 → 私人令牌)"
        return 1
    fi
}

# ─── Git Context ─────────────────────────────────────────────
# Uses parameter expansion (no external commands), works in bash 3.2+
_gitee_context() {
    if [[ -z "${GITEE_OWNER:-}" ]] || [[ -z "${GITEE_REPO:-}" ]]; then
        local remote repo_path
        remote=$(git remote get-url gitee 2>/dev/null || git remote get-url origin 2>/dev/null || true)
        repo_path="${remote#*gitee.com[:/]}"
        repo_path="${repo_path%.git}"
        if [[ "$repo_path" != "$remote" ]] && [[ -n "$repo_path" ]]; then
            GITEE_OWNER="${repo_path%%/*}"
            GITEE_REPO="${repo_path##*/}"
        fi
    fi
    if [[ -z "${GITEE_OWNER:-}" ]] || [[ -z "${GITEE_REPO:-}" ]]; then
        echo "❌ Cannot infer owner/repo. Set GITEE_OWNER and GITEE_REPO, or add a gitee remote." >&2
        return 1
    fi
}

# ─── HTTP Core ───────────────────────────────────────────────
# Token via Authorization header (never in URL/body)
# Response → temp file; HTTP status → stdout. No corrupted newline splitting.
_gitee_http() {
    local method="$1" endpoint="$2" json_body="$3"
    shift 3

    local tmpfile
    tmpfile=$(mktemp /tmp/gitee.XXXXXX)
    # Ensure cleanup even if the function is interrupted
    trap "rm -f '$tmpfile'" EXIT INT TERM

    local http_code url
    local query="$*"

    case "$method" in
        GET)
            # Only append ? when query parameters exist to avoid trailing ?
            if [[ -n "$query" ]]; then
                url="${GITEE_API}${endpoint}?${query}"
            else
                url="${GITEE_API}${endpoint}"
            fi
            http_code=$(curl -sS -w "%{http_code}" -o "$tmpfile" \
                -H "Content-Type: application/json;charset=UTF-8" \
                -H "Authorization: token ${GITEE_TOKEN}" \
                --connect-timeout 10 --max-time 30 \
                "$url" 2>/dev/null) || true
            ;;
        POST|PATCH|PUT|DELETE)
            http_code=$(curl -sS -w "%{http_code}" -o "$tmpfile" \
                -X "$method" \
                -H "Content-Type: application/json;charset=UTF-8" \
                -H "Authorization: token ${GITEE_TOKEN}" \
                --connect-timeout 10 --max-time 30 \
                ${json_body:+-d "$json_body"} \
                "${GITEE_API}${endpoint}" 2>/dev/null) || true
            ;;
    esac

    if [[ "$http_code" -ge 200 ]] && [[ "$http_code" -lt 300 ]]; then
        cat "$tmpfile"
        rm -f "$tmpfile"
        trap - EXIT INT TERM
        return 0
    fi

    local err=""
    case "$http_code" in
        401)
            err="Authentication failed (401). Check your GITEE_TOKEN."
            ;;
        403)
            err="Permission denied (403). Your token may lack required scopes."
            ;;
        *)
            # Safely pass tmpfile via argv to avoid shell injection
            err=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("message",d.get("error_description","")))' "$tmpfile" 2>/dev/null)
            [[ -z "$err" ]] && err="HTTP $http_code"
            ;;
    esac

    echo "❌ ${err}" >&2
    rm -f "$tmpfile"
    trap - EXIT INT TERM
    return 1
}

# ─── JSON Helper ─────────────────────────────────────────────
_json_build() {
    python3 -c "
import json, sys
d = {}
for a in sys.argv[1:]:
    k, v = a.split('=', 1)
    d[k] = v
print(json.dumps(d))
" "$@"
}

# ─── Issue Commands ──────────────────────────────────────────
gitee_issue() {
    _check_token || return 1
    _gitee_context || return 1
    local cmd="${1:-list}"
    case "$cmd" in
        list|ls)
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/issues" "" \
                "state=${2:-open}&sort=created&direction=desc" \
                | python3 -c "
import sys,json
data=json.load(sys.stdin)
if isinstance(data,dict) and 'message' in data:
    print(f'Error: {data[\"message\"]}'); sys.exit(1)
for i in data:
    labels=','.join([l['name'] for l in i.get('labels',[])])
    print(f'#{i[\"number\"]:>6}  [{i[\"state\"]}] {i[\"title\"][:80]}')
    if labels: print(f'         \U0001f3f7 {labels}')
" 2>/dev/null
            ;;
        create|new)
            local title="${2:-}" body="${3:-}" labels="${4:-}"
            [[ -z "$title" ]] && { echo "Usage: gitee issue create \"标题\" \"正文\" [\"标签1,标签2\"]"; return 1; }
            local json_body
            json_body=$(_json_build "repo=${GITEE_REPO}" "title=${title}" \
                ${body:+"body=${body}"} ${labels:+"labels=${labels}"})
            _gitee_http POST "/repos/${GITEE_OWNER}/issues" "$json_body" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Created #{d[\"number\"]}: {d[\"title\"]}\n   {d[\"html_url\"]}')" 2>/dev/null
            ;;
        view|get)
            local num="${2:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee issue view <number>"; return 1; }
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/issues/${num}" "" \
                | python3 -c "
import sys,json
i=json.load(sys.stdin)
print(f'#{i[\"number\"]}  [{i[\"state\"]}]  {i[\"title\"]}')
print(f'Author: {i[\"user\"][\"login\"]}  |  Created: {i[\"created_at\"]}  |  Updated: {i[\"updated_at\"]}')
print(f'URL: {i[\"html_url\"]}')
print()
print(i.get('body','(no body)'))
labels=','.join([l['name'] for l in i.get('labels',[])])
if labels: print(f'\n\U0001f3f7 {labels}')
" 2>/dev/null
            ;;
        close)
            local num="${2:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee issue close <number>"; return 1; }
            _gitee_http PATCH "/repos/${GITEE_OWNER}/issues/${num}" \
                "{\"repo\":\"${GITEE_REPO}\",\"state\":\"closed\"}" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Closed #{d[\"number\"]}')" 2>/dev/null
            ;;
        reopen)
            local num="${2:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee issue reopen <number>"; return 1; }
            _gitee_http PATCH "/repos/${GITEE_OWNER}/issues/${num}" \
                "{\"repo\":\"${GITEE_REPO}\",\"state\":\"open\"}" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Reopened #{d[\"number\"]}')" 2>/dev/null
            ;;
        comment)
            local num="${2:-}" body="${3:-}"
            [[ -z "$num" || -z "$body" ]] && { echo "Usage: gitee issue comment <number> \"评论内容\""; return 1; }
            _gitee_http POST "/repos/${GITEE_OWNER}/${GITEE_REPO}/issues/${num}/comments" \
                "$(_json_build "body=${body}")" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Comment added to #${num}')" 2>/dev/null
            ;;
        edit)
            local num="${2:-}" title="" body="" labels=""
            shift 2 2>/dev/null || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --title)
                        if [[ $# -lt 2 ]]; then echo "❌ --title requires a value" >&2; return 1; fi
                        title="$2"; shift 2 ;;
                    --body)
                        if [[ $# -lt 2 ]]; then echo "❌ --body requires a value" >&2; return 1; fi
                        body="$2"; shift 2 ;;
                    --labels|-l)
                        if [[ $# -lt 2 ]]; then echo "❌ --labels requires a value" >&2; return 1; fi
                        labels="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            [[ -z "$num" ]] && { echo "Usage: gitee issue edit <number> [--title \"...\"] [--body \"...\"] [--labels \"l1,l2\"]"; return 1; }
            _gitee_http PATCH "/repos/${GITEE_OWNER}/issues/${num}" \
                "$(_json_build "repo=${GITEE_REPO}" ${title:+"title=${title}"} ${body:+"body=${body}"} ${labels:+"labels=${labels}"})" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Updated #{d[\"number\"]}')" 2>/dev/null
            ;;
        *) echo "Usage: gitee issue {list|create|view|close|reopen|comment|edit} [args...]" ;;
    esac
}

# ─── PR Commands ─────────────────────────────────────────────
gitee_pr() {
    _check_token || return 1
    _gitee_context || return 1
    local cmd="${1:-list}"
    case "$cmd" in
        list|ls)
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls" "" \
                "state=${2:-open}&sort=created&direction=desc" \
                | python3 -c "
import sys,json
prs=json.load(sys.stdin)
for p in prs:
    print(f'#{p[\"number\"]:>6}  [{p[\"state\"]}] {p[\"title\"][:80]}')
    print(f'         {p[\"head\"][\"ref\"]} → {p[\"base\"][\"ref\"]}  by {p[\"user\"][\"login\"]}')
" 2>/dev/null
            ;;
        create|new)
            local title="${2:-}" body="${3:-}" head="" base="main"
            shift 2 2>/dev/null || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --head) head="$2"; shift 2 ;;
                    --base) base="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            [[ -z "$title" || -z "$head" ]] && {
                echo "Usage: gitee pr create \"标题\" \"正文\" --head <branch> [--base <branch>]"; return 1; }
            _gitee_http POST "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls" \
                "$(_json_build "title=${title}" "head=${head}" "base=${base}" ${body:+"body=${body}"})" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Created PR #{d[\"number\"]}: {d[\"title\"]}\n   {d[\"html_url\"]}')" 2>/dev/null
            ;;
        view|get)
            local num="${2:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee pr view <number>"; return 1; }
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls/${num}" "" \
                | python3 -c "
import sys,json
p=json.load(sys.stdin)
print(f'PR #{p[\"number\"]}  [{p[\"state\"]}]  {p[\"title\"]}')
print(f'Author: {p[\"user\"][\"login\"]}  |  {p[\"head\"][\"ref\"]} → {p[\"base\"][\"ref\"]}')
print(f'Created: {p[\"created_at\"]}  |  Updated: {p[\"updated_at\"]}')
print(f'URL: {p[\"html_url\"]}')
print()
print(p.get('body','(no body)'))
" 2>/dev/null
            ;;
        merge)
            local num="${2:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee pr merge <number>"; return 1; }
            _gitee_http POST "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls/${num}/merge" "{}" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Merged PR #{num}')" 2>/dev/null
            ;;
        close)
            local num="${2:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee pr close <number>"; return 1; }
            _gitee_http PATCH "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls/${num}" \
                '{"state":"closed"}' \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Closed PR #{d[\"number\"]}')" 2>/dev/null
            ;;
        edit)
            local num="${2:-}" title="" body=""
            shift 2 2>/dev/null || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --title)
                        if [[ $# -lt 2 ]]; then echo "❌ --title requires a value" >&2; return 1; fi
                        title="$2"; shift 2 ;;
                    --body)
                        if [[ $# -lt 2 ]]; then echo "❌ --body requires a value" >&2; return 1; fi
                        body="$2"; shift 2 ;;
                    *) shift ;;
                esac
            done
            [[ -z "$num" ]] && { echo "Usage: gitee pr edit <number> [--title \"...\"] [--body \"...\"]"; return 1; }
            _gitee_http PATCH "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls/${num}" \
                "$(_json_build ${title:+"title=${title}"} ${body:+"body=${body}"})" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Updated PR #{d[\"number\"]}')" 2>/dev/null
            ;;
        checkout|co)
            local num="${2:-}" branch="${3:-}"
            [[ -z "$num" ]] && { echo "Usage: gitee pr checkout <number> [branch-name]"; return 1; }
            local pr_json head_ref head_repo
            if ! pr_json=$(_gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/pulls/${num}" "" 2>/dev/null); then
                return 1
            fi
            head_ref=$(echo "$pr_json" | python3 -c "import sys,json; print(json.load(sys.stdin)['head']['ref'])" 2>/dev/null)
            head_repo=$(echo "$pr_json" | python3 -c "import sys,json; print(json.load(sys.stdin)['head']['repo']['full_name'])" 2>/dev/null)
            [[ -z "$head_ref" ]] && { echo "❌ Cannot find PR #${num}"; return 1; }
            local local_branch="${branch:-$head_ref}"
            git fetch gitee "${head_repo##*/}" 2>/dev/null || git fetch origin "${head_repo##*/}" 2>/dev/null || {
                echo "❌ Cannot fetch PR branch. Add a gitee remote, or fetch manually."; return 1; }
            if git show-ref --verify --quiet "refs/heads/$local_branch" 2>/dev/null; then
                git checkout "$local_branch" 2>/dev/null
                git reset --hard FETCH_HEAD
            else
                git checkout -b "$local_branch" FETCH_HEAD 2>/dev/null
            fi
            ;;
        *) echo "Usage: gitee pr {list|create|view|merge|close|edit|checkout} [args...]" ;;
    esac
}

# ─── Repo ────────────────────────────────────────────────────
gitee_repo() {
    _check_token || return 1
    local cmd="${1:-info}"
    case "$cmd" in
        info|view|"")
            _gitee_context || return 1
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}" "" \
                | python3 -c "
import sys,json
r=json.load(sys.stdin)
print(f'Repo: {r[\"full_name\"]}')
print(f'Description: {r.get(\"description\",\"(none)\")}')
print(f'Default branch: {r[\"default_branch\"]}')
print(f'Private: {r[\"private\"]}  |  Forks: {r[\"forks_count\"]}  |  Stars: {r[\"stargazers_count\"]}')
print(f'Open Issues: {r[\"open_issues_count\"]}  |  License: {r.get(\"license\",\"none\")}')
print(f'Created: {r[\"created_at\"]}  |  Updated: {r[\"updated_at\"]}')
print(f'URL: {r[\"html_url\"]}')
" 2>/dev/null
            ;;
        create|new)
            local name="${2:-}" description="" private="false"
            shift 2 2>/dev/null || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --description|-d) description="$2"; shift 2 ;;
                    --private|-p) private="true"; shift ;;
                    *) shift ;;
                esac
            done
            [[ -z "$name" ]] && { echo "Usage: gitee repo create <name> [--description \"desc\"] [--private]"; return 1; }
            _gitee_http POST "/user/repos" \
                "$(_json_build "name=${name}" ${description:+"description=${description}"} "private=${private}")" \
                | python3 -c "import sys,json; r=json.load(sys.stdin); print(f'✅ Created repo: {r[\"full_name\"]}\n   {r[\"html_url\"]}')" 2>/dev/null
            ;;
        delete|rm)
            _gitee_context || return 1
            _gitee_http DELETE "/repos/${GITEE_OWNER}/${GITEE_REPO}" "" \
                | python3 -c "print('✅ Repo deleted: ${GITEE_OWNER}/${GITEE_REPO}')" 2>/dev/null
            ;;
        fork)
            _gitee_context || return 1
            _gitee_http POST "/repos/${GITEE_OWNER}/${GITEE_REPO}/forks" "{}" \
                | python3 -c "import sys,json; r=json.load(sys.stdin); print(f'✅ Forked to: {r[\"full_name\"]}\n   {r[\"html_url\"]}')" 2>/dev/null
            ;;
        star)
            _gitee_context || return 1
            if _gitee_http PUT "/user/starred/${GITEE_OWNER}/${GITEE_REPO}" "{}" > /dev/null 2>&1; then
                echo "⭐ Starred: ${GITEE_OWNER}/${GITEE_REPO}"
            fi
            ;;
        unstar)
            _gitee_context || return 1
            if _gitee_http DELETE "/user/starred/${GITEE_OWNER}/${GITEE_REPO}" "" > /dev/null 2>&1; then
                echo "⭐ Unstarred: ${GITEE_OWNER}/${GITEE_REPO}"
            fi
            ;;
        watch)
            _gitee_context || return 1
            if _gitee_http PUT "/user/subscriptions/${GITEE_OWNER}/${GITEE_REPO}" \
                "$(_json_build "watch_type=watching")" > /dev/null 2>&1; then
                echo "👁 Watching: ${GITEE_OWNER}/${GITEE_REPO}"
            fi
            ;;
        unwatch)
            _gitee_context || return 1
            if _gitee_http DELETE "/user/subscriptions/${GITEE_OWNER}/${GITEE_REPO}" "" > /dev/null 2>&1; then
                echo "👁 Unwatched: ${GITEE_OWNER}/${GITEE_REPO}"
            fi
            ;;
        list|ls)
            local page="${2:-1}" per_page="${3:-20}"
            _gitee_http GET "/user/repos" "" \
                "type=all&sort=updated&direction=desc&page=${page}&per_page=${per_page}" \
                | python3 -c "
import sys,json
repos=json.load(sys.stdin)
if not isinstance(repos,list):
    print('Error:', repos.get('message','unknown')); sys.exit(1)
for r in repos:
    private='🔒' if r['private'] else '🌐'
    print(f'{private} {r[\"full_name\"]:40} ⭐{r[\"stargazers_count\"]:>4}  {r.get(\"description\",\"\")[:50]}')
" 2>/dev/null
            ;;
        *) echo "Usage: gitee repo {info|list|create|delete|fork|star|unstar|watch|unwatch} [args...]" ;;
    esac
}

# ─── Labels ──────────────────────────────────────────────────
gitee_label() {
    _check_token || return 1
    _gitee_context || return 1
    local cmd="${1:-list}"
    case "$cmd" in
        list|ls)
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/labels" "" \
                | python3 -c "
import sys,json
labels=json.load(sys.stdin)
for l in labels:
    print(f'{l[\"name\"]:20} #{l[\"color\"]}')
" 2>/dev/null
            ;;
        create|new)
            local name="${2:-}" color="${3:-}"
            [[ -z "$name" || -z "$color" ]] && { echo "Usage: gitee label create <name> <color-hex>"; echo "Example: gitee label create P0 3d866d"; return 1; }
            color="${color#\#}"
            _gitee_http POST "/repos/${GITEE_OWNER}/${GITEE_REPO}/labels" \
                "$(_json_build "name=${name}" "color=${color}")" \
                | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Label created: {d[\"name\"]} #{d[\"color\"]}')" 2>/dev/null
            ;;
        delete|rm)
            local name="${2:-}"
            [[ -z "$name" ]] && { echo "Usage: gitee label delete <name>"; return 1; }
            _gitee_http DELETE "/repos/${GITEE_OWNER}/${GITEE_REPO}/labels/${name}" "" \
                | python3 -c "print('✅ Label deleted: ${name}')" 2>/dev/null
            ;;
        *) echo "Usage: gitee label {list|create|delete} [args...]" ;;
    esac
}
gitee_labels() { gitee_label list "$@"; }  # backward compat

# ─── Whoami ──────────────────────────────────────────────────
gitee_whoami() {
    _check_token || return 1
    _gitee_http GET "/user" "" \
        | python3 -c "import sys,json; u=json.load(sys.stdin); print(f'{u[\"login\"]} ({u[\"name\"]})\n{u[\"html_url\"]}')" 2>/dev/null
}

# ─── Assign ──────────────────────────────────────────────────
gitee_assign() {
    _check_token || return 1
    _gitee_context || return 1
    local num="${1:-}" user="${2:-}"
    [[ -z "$num" || -z "$user" ]] && { echo "Usage: gitee assign <issue-number> <username>"; return 1; }
    _gitee_http PATCH "/repos/${GITEE_OWNER}/issues/${num}" \
        "$(_json_build "repo=${GITEE_REPO}" "assignee=${user}")" \
        | python3 -c "import sys,json; d=json.load(sys.stdin); print(f'✅ Assigned #{d[\"number\"]} to ${user}')" 2>/dev/null
}

# ─── Search (public, no token) ───────────────────────────────
# Uses Gitee search widget API (so.gitee.com) — same endpoint as opencli.
gitee_search() {
    local keyword="${1:-}" limit="${2:-10}"
    [[ -z "$keyword" ]] && { echo "Usage: gitee search <keyword> [limit]"; return 1; }
    # Clamp limit 1–50
    if [[ "$limit" =~ ^[0-9]+$ ]]; then
        [[ "$limit" -lt 1 ]] && limit=1
        [[ "$limit" -gt 50 ]] && limit=50
    else
        limit=10
    fi
    local tmpfile
    tmpfile=$(mktemp /tmp/gitee.XXXXXX)
    trap "rm -f '$tmpfile'" EXIT INT TERM
    local http_code
    http_code=$(curl -sS -w "%{http_code}" -o "$tmpfile" \
        -H "Accept: application/json" \
        -H "User-Agent: Mozilla/5.0" \
        -H "Referer: https://gitee.com/search?q=${keyword}&type=repository" \
        --connect-timeout 10 --max-time 30 \
        "https://so.gitee.com/v1/search/widget/wong1slagnlmzwvsu5ya?q=${keyword}&from=0&size=${limit}" 2>/dev/null) || true
    if [[ "$http_code" -ge 200 ]] && [[ "$http_code" -lt 300 ]]; then
        python3 -c "
import sys,json
d=json.load(open(sys.argv[1]))
hits=d.get('hits',{})
rows=hits.get('hits',[]) if isinstance(hits,dict) else []
if not rows:
    print('No results found.')
    sys.exit(0)
seen=set()
for r in rows:
    fields=r.get('fields',{})
    def getf(k):
        v=fields.get(k)
        if isinstance(v,list) and v:
            return str(v[0])
        return str(v) if v is not None else ''
    name=getf('title').strip()
    url=getf('url').strip()
    if not name or not url or url in seen:
        continue
    seen.add(url)
    desc=getf('description').strip() or '-'
    lang=getf('langs').strip() or '-'
    stars=getf('count.star').strip() or '-'
    print(f'{name}')
    print(f'  ⭐ {stars}  |  {lang}')
    print(f'  {desc}')
    print(f'  {url}')
    print()
" "$tmpfile" 2>/dev/null
        rm -f "$tmpfile"
        trap - EXIT INT TERM
        return 0
    fi
    echo "❌ Search failed (HTTP $http_code)" >&2
    rm -f "$tmpfile"
    trap - EXIT INT TERM
    return 1
}

# ─── User Profile (public, no token) ─────────────────────────
gitee_user() {
    local username="${1:-}"
    [[ -z "$username" ]] && { echo "Usage: gitee user <username>"; return 1; }
    local tmpfile
    tmpfile=$(mktemp /tmp/gitee.XXXXXX)
    trap "rm -f '$tmpfile'" EXIT INT TERM
    local http_code
    http_code=$(curl -sS -w "%{http_code}" -o "$tmpfile" \
        -H "Accept: application/json" \
        -H "User-Agent: Mozilla/5.0" \
        --connect-timeout 10 --max-time 30 \
        "https://gitee.com/api/v5/users/${username}" 2>/dev/null) || true
    if [[ "$http_code" -ge 200 ]] && [[ "$http_code" -lt 300 ]]; then
        python3 -c "
import sys,json
u=json.load(open(sys.argv[1]))
print(f'User:    {u.get(\"login\", \"-\")}')
print(f'Name:    {u.get(\"name\") or \"-\"}')
print(f'Bio:     {u.get(\"bio\") or \"-\"}')
print(f'Blog:    {u.get(\"blog\") or \"-\"}')
print(f'Company: {u.get(\"company\") or \"-\"}')
print(f'Location:{u.get(\"location\") or \"-\"}')
print(f'Followers:  {u.get(\"followers\", 0)}')
print(f'Following:  {u.get(\"following\", 0)}')
print(f'Public repos:{u.get(\"public_repos\", 0)}')
print(f'Created: {u.get(\"created_at\", \"-\")}')
print(f'URL:     {u.get(\"html_url\", \"-\")}')
" "$tmpfile" 2>/dev/null
        rm -f "$tmpfile"
        trap - EXIT INT TERM
        return 0
    fi
    if [[ "$http_code" == "404" ]]; then
        echo "❌ User '${username}' not found." >&2
    else
        echo "❌ Failed to fetch user profile (HTTP $http_code)" >&2
    fi
    rm -f "$tmpfile"
    trap - EXIT INT TERM
    return 1
}

# ─── Trending / Recommended (public, no token) ───────────────
# Gitee Explore requires a browser (JS-rendered), so we approximate
# by querying the search widget for most-starred repos — same data
# source opencli uses, just accessed via curl instead of a browser.
gitee_trending() {
    local limit="${1:-20}"
    if [[ "$limit" =~ ^[0-9]+$ ]]; then
        [[ "$limit" -lt 1 ]] && limit=1
        [[ "$limit" -gt 50 ]] && limit=50
    else
        limit=20
    fi
    local tmpfile
    tmpfile=$(mktemp /tmp/gitee.XXXXXX)
    trap "rm -f '$tmpfile'" EXIT INT TERM
    local http_code
    http_code=$(curl -sS -w "%{http_code}" -o "$tmpfile" \
        -H "Accept: application/json" \
        -H "User-Agent: Mozilla/5.0" \
        -H "Referer: https://gitee.com/search?q=a&type=repository" \
        --connect-timeout 10 --max-time 30 \
        "https://so.gitee.com/v1/search/widget/wong1slagnlmzwvsu5ya?q=a&sort=stars_count&order=desc&from=0&size=${limit}" 2>/dev/null) || true
    if [[ "$http_code" -ge 200 ]] && [[ "$http_code" -lt 300 ]]; then
        python3 -c "
import sys,json
d=json.load(open(sys.argv[1]))
hits=d.get('hits',{})
rows=hits.get('hits',[]) if isinstance(hits,dict) else []
if not rows:
    print('No trending repositories found.')
    sys.exit(0)
seen=set()
for r in rows:
    fields=r.get('fields',{})
    def getf(k):
        v=fields.get(k)
        if isinstance(v,list) and v:
            return str(v[0])
        return str(v) if v is not None else ''
    name=getf('title').strip()
    url=getf('url').strip()
    if not name or not url or url in seen:
        continue
    seen.add(url)
    desc=getf('description').strip() or '-'
    stars=getf('count.star').strip() or '-'
    print(f'{name}')
    print(f'  ⭐ {stars}')
    print(f'  {desc}')
    print(f'  {url}')
    print()
" "$tmpfile" 2>/dev/null
        rm -f "$tmpfile"
        trap - EXIT INT TERM
        return 0
    fi
    echo "❌ Trending fetch failed (HTTP $http_code)" >&2
    rm -f "$tmpfile"
    trap - EXIT INT TERM
    return 1
}

# ─── Wiki ────────────────────────────────────────────────────
# Gitee Wiki has no REST API; pages are stored in a separate Git repo:
#   https://gitee.com/{owner}/{repo}.wiki.git
# Each page is a .md file. We operate directly on that Git repo.
gitee_wiki() {
    _check_token || return 1
    _gitee_context || return 1
    local cmd="${1:-list}"
    local wiki_url="https://oauth2:${GITEE_TOKEN}@gitee.com/${GITEE_OWNER}/${GITEE_REPO}.wiki.git"
    local tmpdir
    tmpdir=$(mktemp -d /tmp/gitee.wiki.XXXXXX)
    trap "rm -rf '$tmpdir'" EXIT INT TERM

    case "$cmd" in
        list|ls)
            if ! git clone -q "$wiki_url" "$tmpdir" 2>/dev/null; then
                echo "❌ No wiki found for ${GITEE_OWNER}/${GITEE_REPO} (or not enabled)." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            local found=0
            for f in "$tmpdir"/*.md; do
                [[ -f "$f" ]] || continue
                found=1
                local name
                name=$(basename "$f" .md)
                echo "  $name"
            done
            [[ "$found" -eq 0 ]] && echo "  (no wiki pages)"
            ;;
        get|view)
            local slug="${2:-}"
            [[ -z "$slug" ]] && { echo "Usage: gitee wiki get <slug>"; return 1; }
            if ! git clone -q "$wiki_url" "$tmpdir" 2>/dev/null; then
                echo "❌ No wiki found for ${GITEE_OWNER}/${GITEE_REPO}." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            local file_path="$tmpdir/${slug}.md"
            if [[ -f "$file_path" ]]; then
                cat "$file_path"
            else
                echo "❌ Wiki page '${slug}' not found." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            ;;
        create|new)
            local title="${2:-}" body="${3:-}"
            [[ -z "$title" || -z "$body" ]] && { echo "Usage: gitee wiki create \"title\" \"body\""; return 1; }
            git clone -q "$wiki_url" "$tmpdir" 2>/dev/null || {
                # Wiki repo may not exist yet; initialise it
                git init -q "$tmpdir"
                cd "$tmpdir"
                git remote add origin "$wiki_url"
                git config user.email "gitee-cli@local"
                git config user.name "gitee-cli"
                cd - >/dev/null
            }
            local file_path="$tmpdir/${title}.md"
            printf '%s\n' "$body" > "$file_path"
            cd "$tmpdir"
            git add "${title}.md" >/dev/null 2>&1 || true
            git -c user.email="gitee-cli@local" -c user.name="gitee-cli" \
                commit -q -m "Update wiki page: ${title}" >/dev/null 2>&1 || {
                # Nothing to commit (file unchanged)
                cd - >/dev/null
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                echo "✅ Wiki page '${title}' is up to date."
                return 0
            }
            if git push -q origin master 2>/dev/null; then
                cd - >/dev/null
                echo "✅ Wiki page '${title}' created/updated."
            else
                cd - >/dev/null
                echo "❌ Failed to push wiki page." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            ;;
        delete|rm)
            local slug="${2:-}"
            [[ -z "$slug" ]] && { echo "Usage: gitee wiki delete <slug>"; return 1; }
            if ! git clone -q "$wiki_url" "$tmpdir" 2>/dev/null; then
                echo "❌ No wiki found for ${GITEE_OWNER}/${GITEE_REPO}." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            local file_path="$tmpdir/${slug}.md"
            if [[ ! -f "$file_path" ]]; then
                echo "❌ Wiki page '${slug}' not found." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            cd "$tmpdir"
            git rm -q "${slug}.md" 2>/dev/null || true
            git -c user.email="gitee-cli@local" -c user.name="gitee-cli" \
                commit -q -m "Delete wiki page: ${slug}" >/dev/null 2>&1 || true
            if git push -q origin master 2>/dev/null; then
                cd - >/dev/null
                echo "✅ Wiki page '${slug}' deleted."
            else
                cd - >/dev/null
                echo "❌ Failed to push wiki delete." >&2
                rm -rf "$tmpdir"
                trap - EXIT INT TERM
                return 1
            fi
            ;;
        *) echo "Usage: gitee wiki {list|get|create|delete} [args...]" ;;
    esac
    rm -rf "$tmpdir"
    trap - EXIT INT TERM
}

# ─── Release ─────────────────────────────────────────────────
gitee_release() {
    _check_token || return 1
    _gitee_context || return 1
    local cmd="${1:-list}"
    case "$cmd" in
        list|ls)
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/releases" "" \
                | python3 -c "
import sys,json
rels=json.load(sys.stdin)
if not isinstance(rels,list):
    print('Error:', rels.get('message','unknown')); sys.exit(1)
if not rels:
    print('No releases found.')
    sys.exit(0)
for r in rels:
    draft='[draft]' if r.get('draft') else ''
    pre='[pre]' if r.get('prerelease') else ''
    print(f'{r[\"tag_name\"]:20} {draft} {pre}')
    print(f'  {r.get(\"name\",\"\")}')
    print(f'  {r.get(\"html_url\", \"-\")}')
    print()
" 2>/dev/null
            ;;
        view|get)
            local tag="${2:-}"
            [[ -z "$tag" ]] && { echo "Usage: gitee release view <tag>"; return 1; }
            _gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/releases/tags/${tag}" "" \
                | python3 -c "
import sys,json
r=json.load(sys.stdin)
if isinstance(r,dict) and 'message' in r:
    print(f'Error: {r[\"message\"]}'); sys.exit(1)
print(f'Tag: {r[\"tag_name\"]}')
print(f'Name: {r.get(\"name\",\"\")}')
print(f'Author: {r[\"author\"][\"login\"]}')
print(f'Created: {r[\"created_at\"]}')
print(f'URL: {r.get(\"html_url\", \"-\")}')
print()
print(r.get('body','(no body)'))
assets=r.get('assets',[])
if assets:
    print(f'\nAssets ({len(assets)}):')
    for a in assets:
        print(f'  - {a.get(\"name\",\"\")} ({a.get(\"size\",0)} bytes)')
        print(f'    {a.get(\"browser_download_url\",\"\")}')
" 2>/dev/null
            ;;
        create|new)
            local tag="${2:-}" title="" body=""
            shift 2 2>/dev/null || true
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --title|-t) title="$2"; shift 2 ;;
                    --body|-b) body="$2"; shift 2 ;;
                    *) [[ -z "$title" ]] && title="$1" || body="$1"; shift ;;
                esac
            done
            [[ -z "$tag" ]] && { echo "Usage: gitee release create <tag> [--title \"name\"] [--body \"notes\"]"; return 1; }
            [[ -z "$title" ]] && title="${tag}"
            _gitee_http POST "/repos/${GITEE_OWNER}/${GITEE_REPO}/releases" \
                "$(_json_build "tag_name=${tag}" "name=${title}" "target_commitish=main" ${body:+"body=${body}"})" \
                | python3 -c "import sys,json; r=json.load(sys.stdin); print(f'✅ Release created: {r[\"tag_name\"]}\n   {r.get(\"html_url\", \"-\")}')" 2>/dev/null
            ;;
        delete|rm)
            local tag="${2:-}"
            [[ -z "$tag" ]] && { echo "Usage: gitee release delete <tag>"; return 1; }
            # Need release id to delete; lookup by tag first
            local rel_json release_id
            rel_json=$(_gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/releases/tags/${tag}" "" 2>/dev/null) || { echo "❌ Release '${tag}' not found." >&2; return 1; }
            release_id=$(echo "$rel_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',''))" 2>/dev/null)
            [[ -z "$release_id" ]] && { echo "❌ Cannot find release id for '${tag}'." >&2; return 1; }
            _gitee_http DELETE "/repos/${GITEE_OWNER}/${GITEE_REPO}/releases/${release_id}" "" \
                | python3 -c "print('✅ Release ${tag} deleted.')" 2>/dev/null
            ;;
        upload)
            local tag="${2:-}" filepath="${3:-}"
            [[ -z "$tag" || -z "$filepath" ]] && { echo "Usage: gitee release upload <tag> <file-path>"; return 1; }
            [[ -f "$filepath" ]] || { echo "❌ File not found: ${filepath}" >&2; return 1; }
            # Lookup release id by tag
            local rel_json release_id
            rel_json=$(_gitee_http GET "/repos/${GITEE_OWNER}/${GITEE_REPO}/releases/tags/${tag}" "" 2>/dev/null) || { echo "❌ Release '${tag}' not found." >&2; return 1; }
            release_id=$(echo "$rel_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',''))" 2>/dev/null)
            [[ -z "$release_id" ]] && { echo "❌ Cannot find release id for '${tag}'." >&2; return 1; }
            local tmpfile
            tmpfile=$(mktemp /tmp/gitee.XXXXXX)
            trap "rm -f '$tmpfile'" EXIT INT TERM
            local http_code
            http_code=$(curl -sS -w "%{http_code}" -o "$tmpfile" \
                -X POST \
                -H "Authorization: token ${GITEE_TOKEN}" \
                -F "file=@${filepath}" \
                --connect-timeout 10 --max-time 120 \
                "${GITEE_API}/repos/${GITEE_OWNER}/${GITEE_REPO}/releases/${release_id}/attach_files" 2>/dev/null) || true
            if [[ "$http_code" -ge 200 ]] && [[ "$http_code" -lt 300 ]]; then
                python3 -c "import sys,json; a=json.load(open(sys.argv[1])); print(f'✅ Uploaded: {a[\"name\"]} ({a[\"size\"]} bytes)\n   {a[\"browser_download_url\"]}')" "$tmpfile" 2>/dev/null
                rm -f "$tmpfile"
                trap - EXIT INT TERM
                return 0
            fi
            local err=""
            err=$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d.get("message",d.get("error_description","")))' "$tmpfile" 2>/dev/null)
            [[ -z "$err" ]] && err="HTTP $http_code"
            echo "❌ Upload failed: ${err}" >&2
            rm -f "$tmpfile"
            trap - EXIT INT TERM
            return 1
            ;;
        *) echo "Usage: gitee release {list|view|create|delete|upload} [args...]" ;;
    esac
}

# ─── Main Dispatch ───────────────────────────────────────────
gitee() {
    local cmd="${1:-}"
    case "$cmd" in
        issue|issues)    shift; gitee_issue "$@" ;;
        pr|pull)         shift; gitee_pr "$@" ;;
        repo)            shift; gitee_repo "$@" ;;
        label|labels)    shift; gitee_label "$@" ;;
        whoami|who)      shift; gitee_whoami "$@" ;;
        assign)          shift; gitee_assign "$@" ;;
        search)          shift; gitee_search "$@" ;;
        user)            shift; gitee_user "$@" ;;
        trending)        shift; gitee_trending "$@" ;;
        wiki)             shift; gitee_wiki "$@" ;;
        release)          shift; gitee_release "$@" ;;
        help|--help|-h)
            echo "gitee — Gitee API v5 CLI (like gh for GitHub)"
            echo "Version: ${GITEE_CLI_VERSION}"
            echo ""
            echo "Commands:"
            echo "  gitee issue list [state]              List issues"
            echo "  gitee issue create <title> <body>     Create issue"
            echo "  gitee issue view <number>             View issue"
            echo "  gitee issue close <number>            Close issue"
            echo "  gitee issue reopen <number>           Reopen issue"
            echo "  gitee issue comment <n> <body>        Add comment"
            echo "  gitee issue edit <number>             Edit issue"
            echo "         [--title] [--body] [--labels]"
            echo "  gitee pr list [state]                 List PRs"
            echo "  gitee pr create <title> <body>        Create PR"
            echo "         --head <branch> [--base <branch>]"
            echo "  gitee pr view <number>                View PR"
            echo "  gitee pr merge <number>               Merge PR"
            echo "  gitee pr close <number>               Close PR"
            echo "  gitee pr edit <number>                Edit PR"
            echo "         [--title] [--body]"
            echo "  gitee pr checkout <number>            Checkout PR branch"
            echo "  gitee repo                            Show repo info"
            echo "  gitee repo create <name>              Create repository"
            echo "         [--description] [--private]"
            echo "  gitee repo delete                     Delete repository"
            echo "  gitee repo fork                       Fork repository"
            echo "  gitee repo star                       Star repository"
            echo "  gitee repo unstar                     Unstar repository"
            echo "  gitee repo watch                      Watch repository"
            echo "  gitee repo unwatch                    Unwatch repository"
            echo "  gitee label list                      List labels"
            echo "  gitee label create <name> <color>     Create label"
            echo "  gitee label delete <name>             Delete label"
            echo "  gitee assign <issue> <username>       Assign issue"
            echo "  gitee whoami                          Show current user"
            echo "  gitee search <keyword> [limit]        Search repositories"
            echo "  gitee user <username>                 Show user profile"
            echo "  gitee trending [limit]                Trending repositories"
            echo "  gitee wiki list                       List wiki pages"
            echo "  gitee wiki get <slug>                 View wiki page"
            echo "  gitee wiki create \"title\" \"body\"    Create/update wiki page"
            echo "  gitee wiki delete <slug>              Delete wiki page"
            echo "  gitee release list                    List releases"
            echo "  gitee release view <tag>              View release"
            echo "  gitee release create <tag>            Create release"
            echo "         [--title \"name\"] [--body \"notes\"]"
            echo "  gitee release delete <tag>            Delete release"
            echo "  gitee release upload <tag> <file>     Upload release asset"
            echo "  gitee version                         Show version"
            echo ""
            echo "Auth: token via Authorization header (never in URL/body)"
            echo "Setup: export GITEE_TOKEN='your-token'"
            echo "Home:  https://gitee.com/sculkj/gitee-cli"
            ;;
        version|--version|-v)
            echo "gitee-cli ${GITEE_CLI_VERSION}"
            ;;
        *) echo "Unknown command: $cmd"; echo "Run 'gitee help' for usage." ;;
    esac
}

